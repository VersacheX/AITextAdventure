# Example .env for AITextAdventure Old User API

# Database connection (ODBC for SQL Server shown). Replace placeholders.
DATABASE_URL=mssql+pyodbc://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>?driver=ODBC+Driver+17+for+SQL+Server

# Password pepper used when hashing (optional)
SECRET_KEY=your_password_pepper_here

# JWT signing secret (used to sign access/refresh tokens)
JWT_SECRET=your_jwt_signing_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Server / client settings
API_SERVER_URL=http://localhost:2222
USER_API_HOST=127.0.0.1
USER_API_PORT=8001

# Usage: copy this file to .env and fill in values before starting the service.
